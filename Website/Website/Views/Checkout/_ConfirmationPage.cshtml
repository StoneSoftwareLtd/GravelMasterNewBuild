@model Agilis.ECommerce.Mvc.Web.ViewModels.Common.ConfirmationPageModel
@using Agilis.ECommerce.Mvc.Web.ViewModels.Common
@* New order confirmation from the Optima prototype (confirmation.html), shown by Checkout/OrderResult.cshtml when the new
   chrome is on, after payment. Styles: css/gm-confirmation.css (and the Caveat font), loaded in OrderResult.cshtml's Head
   section. Behaviour: js/gm-confirmation.js.
   - It shows what the old page did: the order number, the amount paid, where the confirmation email goes and the
     delivery address.
   - "Track your order" opens the site's own Track Order pop-up (_TrackOrderModal), filled in with the order number
     and the delivery postcode.
   - "Add to basket" on a suggestion calls /basket/addtobasket as the basket page's suggestions do, then goes to the
     basket. It never reloads this page: loading /checkout/orderresult isn't only a page view, it marks the order as paid. *@
<div class="gm-confirm" data-postal-area="@Model.PostalArea">
    <div class="container">
        <nav class="cnf-crumbs" aria-label="Breadcrumb">
            <ol class="cnf-crumbs__list">
                <li><a href="/">Home</a></li>
                <li><span class="cnf-crumbs__current" aria-current="page">Order confirmation</span></li>
            </ol>
        </nav>

        <section class="cnf-hero" aria-labelledby="cnf-title">
            <div class="cnf-art" aria-hidden="true">
                <span class="cnf-art__blob"></span>
                <svg class="cnf-art__tick" viewBox="0 0 200 150" width="200" height="150">
                    <g stroke="#2f6b34" stroke-width="5" stroke-linecap="round">
                        <line x1="30" y1="42" x2="42" y2="52" /><line x1="22" y1="80" x2="40" y2="80" /><line x1="30" y1="112" x2="42" y2="104" />
                        <line x1="170" y1="42" x2="158" y2="52" /><line x1="178" y1="80" x2="160" y2="80" /><line x1="170" y1="112" x2="158" y2="104" />
                    </g>
                    <circle cx="100" cy="78" r="46" fill="#2f6b34" />
                    <path d="M78 79l15 15 30-31" fill="none" stroke="#fff" stroke-width="11" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <img class="cnf-art__bag cnf-art__bag--back" src="/img/gm-confirm-bag.png" alt="" width="600" height="600">
                <img class="cnf-art__bag cnf-art__bag--front" src="/img/gm-confirm-bag.png" alt="" width="600" height="600">
            </div>

            <div class="cnf-copy">
                <h1 class="cnf-title" id="cnf-title">Thank you for your order!</h1>
                <p class="cnf-orderno">Order number: @Model.OrderNumber</p>
                <p>We&rsquo;ve received your payment of @HomeProduct.FormatPrice(Model.AmountPaid, true), and your order is now being processed by our team.</p>
                @if (!string.IsNullOrWhiteSpace(Model.DeliveryAddress))
                {
                    <p class="cnf-address"><strong>Delivering to:</strong> @Model.DeliveryAddress</p>
                }
                <p>If we need anything else to arrange your delivery, we&rsquo;ll be in touch. Thank you for choosing GravelMaster.</p>
                <div class="cnf-actions">
                    <a class="cnf-btn cnf-btn--solid" href="#" data-toggle="modal" data-target="#trackModal" data-track data-order="@Model.OrderNumber" data-postcode="@Model.DeliveryPostcode"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="6" width="13" height="10" rx="1" /><path d="M14 9h4l3 3v4h-7z" /><circle cx="5.5" cy="17" r="1.6" /><circle cx="17.5" cy="17" r="1.6" /></svg> Track your order</a>
                    <a class="cnf-btn cnf-btn--outline" href="/"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 4h2.2l2.3 10.2a1 1 0 0 0 1 .8h9.2a1 1 0 0 0 1-.76L20 8H6" /><circle cx="9.5" cy="19" r="1.4" /><circle cx="16.5" cy="19" r="1.4" /></svg> Continue shopping</a>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Email))
            {
                <aside class="cnf-email" aria-label="Confirmation email">
                    <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3.5 6.5l8.5 6.5 8.5-6.5" /></svg>
                    <div>
                        <p class="cnf-email__title">Your confirmation email is on its way to <span class="cnf-email__address">@Html.Raw(Html.Encode(Model.Email).Replace("@", "@<wbr>"))</span></p>
                        <p class="cnf-email__text">Check your inbox (and spam folder) for your order details.</p>
                    </div>
                </aside>
            }
        </section>
    </div>

    @if (Model.Suggestions.Count > 0)
    {
        <section class="cnf-recommend" aria-labelledby="cnf-recommend-title">
            <div class="container">
                <h2 class="cnf-recommend__title" id="cnf-recommend-title">You might also like</h2>
                <ul class="cnf-recommend__grid">
                    @foreach (var product in Model.Suggestions)
                    {
                        <li class="cnf-rec">
                            <img class="cnf-rec__img" src="@product.ImageUrl" alt="" width="330" height="330" loading="lazy" decoding="async">
                            <h3 class="cnf-rec__name"><a href="@product.Url">@product.Name</a></h3>
                            <p class="cnf-rec__price">@HomeProduct.FormatPrice(product.Price, true)@(product.PriceUnit != null ? " " + product.PriceUnit : "")</p>
                            <button class="cnf-rec__btn" type="button" data-add="@product.ProductCode" data-variant="@product.VariantCode">
                                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 4h2.2l2.3 10.2a1 1 0 0 0 1 .8h9.2a1 1 0 0 0 1-.76L20 8H6" /><circle cx="9.5" cy="19" r="1.4" /><circle cx="16.5" cy="19" r="1.4" /></svg>
                                Add to basket
                            </button>
                        </li>
                    }
                </ul>
                <p class="cnf-status" role="status" data-status></p>
            </div>
        </section>
    }

    <div class="cnf-strip">
        <div class="container cnf-strip__inner">
            <p class="cnf-strip__help">Need help? Call <a href="tel:03300585068">0330 058 5068</a></p>
            <p class="cnf-strip__tag" aria-hidden="true">Building better outdoor spaces, together.</p>
        </div>
    </div>
</div>
<script src="/js/gm-confirmation.js?v1"></script>
