@model Agilis.ECommerce.Mvc.Web.ViewModels.Common.AccountFormModel
@using Agilis.ECommerce.Mvc.Web.ViewModels.Common
@* New reset-password page (the link in the reset email), shown by Account/ResetPassword.cshtml when the new chrome is on.
   It posts Email, Password, ConfirmPassword, Code and the anti-forgery token to /account/resetpassword, as the old form
   did. Styles: css/gm-account.css. Behaviour: js/gm-account.js. *@
<link href="/css/gm-account.css?v1" rel="stylesheet" />
<div class="gm-account" data-account data-focus="@(Model.Errors.Count > 0 ? "form-errors" : "")">
    <div class="container acc-container">
        <nav class="acc-crumbs" aria-label="Breadcrumb">
            <ol class="acc-crumbs__list">
                <li><a href="/">Home</a></li>
                <li><a href="/account/login">My account</a></li>
                <li><span class="acc-crumbs__current" aria-current="page">Choose a new password</span></li>
            </ol>
        </nav>
        <div class="acc-narrow">
            <section class="acc-panel" aria-labelledby="acc-reset-h">
                <h1 class="acc-title acc-title--panel" id="acc-reset-h">Choose a new password</h1>
                <p class="acc-intro">Enter your email address and a new password for your account.</p>
                @if (Model.Errors.Count > 0)
                {
                    <div class="acc-errors" role="alert" tabindex="-1" id="form-errors">
                        <ul>
                            @foreach (var error in Model.Errors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </div>
                }
                <form class="acc-form" action="/account/resetpassword" method="post" data-account-form>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Code" value="@Model.Code">
                    <div class="acc-field">
                        <label for="acc-reset-email">Email address</label>
                        <input class="acc-input" id="acc-reset-email" name="Email" type="email" autocomplete="username" required value="@Model.Email" data-msg-required="Please enter your email address." data-msg-email="Please enter an email address like name@@example.com.">
                    </div>
                    <div class="acc-field">
                        <label for="acc-reset-password">New password</label>
                        <div class="acc-password">
                            <input class="acc-input" id="acc-reset-password" name="Password" type="password" autocomplete="new-password" required minlength="6" maxlength="100" aria-describedby="acc-reset-password-hint" data-msg-required="Please choose a new password." data-msg-length="Please use at least 6 characters.">
                            <button class="acc-password__show" type="button" aria-pressed="false" aria-controls="acc-reset-password" data-show-password>Show</button>
                        </div>
                        <p class="acc-hint" id="acc-reset-password-hint">At least 6 characters.</p>
                    </div>
                    <div class="acc-field">
                        <label for="acc-reset-confirm">Confirm new password</label>
                        <input class="acc-input" id="acc-reset-confirm" name="ConfirmPassword" type="password" autocomplete="new-password" required data-match="acc-reset-password" data-msg-required="Please type the new password again." data-msg-match="The two passwords don&rsquo;t match.">
                    </div>
                    <button class="acc-btn acc-btn--primary" type="submit" data-busy-text="Saving">Save my new password</button>
                </form>
                <p class="acc-alt"><a href="/account/login">Back to sign in</a></p>
            </section>
        </div>
    </div>
</div>
<script src="/js/gm-account.js?v1"></script>
