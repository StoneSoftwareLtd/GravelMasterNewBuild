@model Agilis.ECommerce.Mvc.Web.ViewModels.Common.AccountFormModel
@using Agilis.ECommerce.Mvc.Web.ViewModels.Common
@* New forgotten-password page, shown by Account/ForgotPassword.cshtml when the new chrome is on. It posts Email and the
   anti-forgery token to /account/forgotpassword, as the old form did. Styles: css/gm-account.css. Behaviour: js/gm-account.js. *@
<link href="/css/gm-account.css?v1" rel="stylesheet" />
<div class="gm-account" data-account data-focus="@(Model.Errors.Count > 0 ? "form-errors" : "")">
    <div class="container acc-container">
        <nav class="acc-crumbs" aria-label="Breadcrumb">
            <ol class="acc-crumbs__list">
                <li><a href="/">Home</a></li>
                <li><a href="/account/login">My account</a></li>
                <li><span class="acc-crumbs__current" aria-current="page">Forgotten password</span></li>
            </ol>
        </nav>
        <div class="acc-narrow">
            <section class="acc-panel" aria-labelledby="acc-forgot-h">
                <h1 class="acc-title acc-title--panel" id="acc-forgot-h">Forgotten your password?</h1>
                <p class="acc-intro">Enter the email address you signed up with, and we&rsquo;ll email you a link to choose a new password.</p>
                @if (Model.Errors.Count > 0)
                {
                    <div class="acc-errors" role="alert" tabindex="-1" id="form-errors">
                        <ul>
                            @foreach (var error in Model.Errors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </div>
                }
                <form class="acc-form" action="/account/forgotpassword" method="post" data-account-form>
                    @Html.AntiForgeryToken()
                    <div class="acc-field">
                        <label for="acc-forgot-email">Email address</label>
                        <input class="acc-input" id="acc-forgot-email" name="Email" type="email" autocomplete="email" required value="@Model.Email" data-msg-required="Please enter your email address." data-msg-email="Please enter an email address like name@@example.com.">
                    </div>
                    <button class="acc-btn acc-btn--primary" type="submit" data-busy-text="Sending">Email me a link</button>
                </form>
                <p class="acc-alt"><a href="/account/login">Back to sign in</a></p>
            </section>
        </div>
    </div>
</div>
<script src="/js/gm-account.js?v1"></script>
