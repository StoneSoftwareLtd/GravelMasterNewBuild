@model Agilis.ECommerce.Mvc.Web.ViewModels.Common.AccountMessage
@using Agilis.ECommerce.Mvc.Web.ViewModels.Common
@{
    bool email = Model == AccountMessage.PasswordResetEmailSent || Model == AccountMessage.Registered;
    string crumb = Model == AccountMessage.TradeApplicationSent ? "Trade account" : "My account";
}
@* The account pages that only say something, in the new design: shown by ForgotPasswordConfirmation, ResetPasswordConfirmation,
   ConfirmEmail, SuccessRegister and TradeRegisterDone (Views/Account) when the new chrome is on, each with its own
   AccountMessage. Their words are here, rewritten from the old pages to say what actually happens (see
   docs/account-pages.md). Styles: css/gm-account.css. *@
<link href="/css/gm-account.css?v1" rel="stylesheet" />
<div class="gm-account">
    <div class="container acc-container">
        <nav class="acc-crumbs" aria-label="Breadcrumb">
            <ol class="acc-crumbs__list">
                <li><a href="/">Home</a></li>
                <li><span class="acc-crumbs__current" aria-current="page">@crumb</span></li>
            </ol>
        </nav>
        <div class="acc-narrow">
            <section class="acc-panel acc-panel--centre" aria-labelledby="acc-message-h">
                <span class="acc-badge" aria-hidden="true">
                    @if (email)
                    {
                        <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3.5 6.5l8.5 6.5 8.5-6.5" /></svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 12.5 10 17.5 19 7" /></svg>
                    }
                </span>
                @switch (Model)
                {
                    case AccountMessage.PasswordResetEmailSent:
                        <h1 class="acc-title" id="acc-message-h">Check your email</h1>
                        <p class="acc-intro">If there&rsquo;s an account for that email address, we&rsquo;ve sent it a link to choose a new password.</p>
                        <p class="acc-small">It can take a few minutes to arrive. If you can&rsquo;t see it, check your spam folder.</p>
                        <div class="acc-actions"><a class="acc-btn acc-btn--secondary" href="/account/login">Back to sign in</a></div>
                        break;
                    case AccountMessage.PasswordReset:
                        <h1 class="acc-title" id="acc-message-h">Your password has been changed</h1>
                        <p class="acc-intro">You can now sign in with your new password.</p>
                        <div class="acc-actions"><a class="acc-btn acc-btn--primary" href="/account/login">Sign in</a></div>
                        break;
                    case AccountMessage.EmailConfirmed:
                        <h1 class="acc-title" id="acc-message-h">Your email address is confirmed</h1>
                        <p class="acc-intro">Thank you for confirming your email. You can now sign in.</p>
                        <div class="acc-actions"><a class="acc-btn acc-btn--primary" href="/account/login">Sign in</a></div>
                        break;
                    case AccountMessage.Registered:
                        <h1 class="acc-title" id="acc-message-h">Thank you for registering!</h1>
                        <p class="acc-intro">Nearly there. We&rsquo;ve emailed you a link to confirm your email address:</p>
                        <ol class="acc-steps">
                            <li>Open the email called &ldquo;Confirm your account&rdquo;.</li>
                            <li>Click the link in it.</li>
                            <li>Sign in with your email address and password.</li>
                        </ol>
                        <p class="acc-small">If you can&rsquo;t see the email, check your spam folder.</p>
                        <div class="acc-actions"><a class="acc-btn acc-btn--secondary" href="/">Continue shopping</a></div>
                        break;
                    default:
                        <h1 class="acc-title" id="acc-message-h">Thank you for your application</h1>
                        <p class="acc-intro">We have your trade account application, and we&rsquo;ll be in touch by email shortly.</p>
                        <div class="acc-actions">
                            <a class="acc-btn acc-btn--secondary" href="/">Continue shopping</a>
                            <a class="acc-btn acc-btn--ghost" href="/trade">About trade accounts</a>
                        </div>
                        break;
                }
            </section>
        </div>
    </div>
</div>
