@model Agilis.ECommerce.Mvc.Web.ViewModels.Common.CalculatorPageModel
@using Agilis.ECommerce.Mvc.Web.ViewModels.Common
@{
    // "Gravel & Slate Calculator FAQs", as the live page words them
    var faqs = new[]
    {
        new { Question = "How much gravel do I need for my driveway?", Answer = "Calculating an accurate estimate of how much gravel or aggregate you need for a driveway is simple with our gravel calculator. All you need to know is the desired length and width of the driveway, along with what gravel depth you need. You can get an estimate right now using the calculator above." },
        new { Question = "How much gravel do I need for my garden?", Answer = "To calculate how much gravel you require for your garden, you must know the approximate area you are working with, and the desired depth. For gardens, this can be trickier as the shape may not be a simple square. We recommend extending this to make it a square, as it is better to order too many aggregates than too few." },
        new { Question = "What depth of gravel do I need?", Answer = "You would usually lay a 10mm aggregate at a depth of 30-40mm, but on a driveway this would need to be at least 50mm. A 20mm aggregate would need to be at least 40-50mm deep, and at least 50-60mm on driveways. A larger aggregate will settle and bond together better than smaller ones. The depth you will need to select for your gravel or slate will always depend on the aggregate size and what the surface will be used for." },
        new { Question = "Example gravel estimate", Answer = "We estimate an area of 5 metres by 5 metres, with a depth of 40mm, would require approximately three bulk bags of aggregates, slate chippings or gravel." },
        new { Question = "Can you use the gravel calculator for all aggregates?", Answer = "Our gravel calculator can be used for most gravel and aggregates featured on our website." },
        new { Question = "Do you need assistance?", Answer = "If you are ordering a large amount of gravel, aggregate or slate maybe you would like to discuss it with us on 0330 058 5068, as there may be transport savings to be made on orders over 15 bulk bags, or on a loose tipped load of 20 tonnes or more." }
    };
}
@* New calculator page, shown by Content/Calculator.cshtml for /calculator when the new chrome is on. There's no Optima
   prototype for it, so it's in the Trade Accounts page's style around the shared quantity calculator
   (_QuantityCalculator.cshtml), which has the live page's four formulas and its Email Results post. The words are the
   live page's own; docs/calculator-page.md lists the few changes. Styles: css/gm-info.css, loaded in
   Calculator.cshtml's Head section (the calculator and the bulk enquiry pop-up load their own). *@
<div class="gm-info gm-calcpage">
    <section class="inf-intro">
        <nav class="container inf-crumbs" aria-label="Breadcrumb">
            <ol class="inf-crumbs__list">
                <li><a href="/">Home</a></li>
                <li><span class="inf-crumbs__current" aria-current="page">Gravel calculator</span></li>
            </ol>
        </nav>
        <div class="container">
            <p class="inf-eyebrow">Quantity calculator</p>
            <h1 class="inf-intro__title">Gravel calculator</h1>
            <p class="inf-intro__lead">Calculate how much gravel you need</p>
            <p class="inf-intro__text">To ensure that you receive the correct amount of gravel we recommend that you use the gravel calculator below. The calculator will help you get an approximate volume of gravel required. The depth you will need for the gravel and aggregates will depend on what size you use and what it is used for.</p>
        </div>
    </section>

    @* Inside .gm-info, whose shield keeps the old site's heading colours off it, as the homepage's does *@
    @Html.Partial("_QuantityCalculator", Model.Calculator)

    <section class="inf-section" aria-labelledby="calc-how">
        <div class="container inf-measure">
            <div class="inf-text">
                <h2 class="inf-h2" id="calc-how">How do you calculate how much gravel is needed?</h2>
                <p>All you need to know is the size of the area you wish to cover, what depth of gravel or slate you require, and your post-code. The size information helps calculate how much gravel or slate you will require, while your post-code helps us calculate a cost estimate based on delivery. Try it yourself now.</p>
                <p>Note: This calculator is only intended as a rough guide to help you approximate the likely volume of <a href="/garden-chippings/products/">gravel</a>, <a href="/garden-chippings/slate-chippings/products/">slate</a> or other aggregates needed for your project.</p>
            </div>
            <svg class="inf-diagram" viewBox="0 0 500 250" role="img" aria-label="An area of gravel, measured by its length, width and depth">
                <defs>
                    <marker id="calc-arrow" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 1 10 5 0 9z" fill="#2f6b34" /></marker>
                </defs>
                <polygon points="60,110 250,50 410,100 220,160" fill="#dfe9d0" stroke="#2f6b34" stroke-width="2" stroke-linejoin="round" />
                <polygon points="60,110 220,160 220,190 60,140" fill="#bcd2a2" stroke="#2f6b34" stroke-width="2" stroke-linejoin="round" />
                <polygon points="220,160 410,100 410,130 220,190" fill="#a4bf86" stroke="#2f6b34" stroke-width="2" stroke-linejoin="round" />
                <g fill="#9bb77c">
                    <circle cx="150" cy="100" r="4" /><circle cx="190" cy="118" r="3" /><circle cx="230" cy="92" r="4" /><circle cx="270" cy="112" r="3.5" />
                    <circle cx="300" cy="90" r="3" /><circle cx="210" cy="136" r="3.5" /><circle cx="330" cy="108" r="4" /><circle cx="120" cy="116" r="3" /><circle cx="250" cy="70" r="3" />
                </g>
                <line x1="58" y1="160" x2="214" y2="209" stroke="#2f6b34" stroke-width="2" marker-start="url(#calc-arrow)" marker-end="url(#calc-arrow)" />
                <line x1="228" y1="209" x2="408" y2="152" stroke="#2f6b34" stroke-width="2" marker-start="url(#calc-arrow)" marker-end="url(#calc-arrow)" />
                <line x1="428" y1="100" x2="428" y2="130" stroke="#2f6b34" stroke-width="2" marker-start="url(#calc-arrow)" marker-end="url(#calc-arrow)" />
                <text x="118" y="222" transform="rotate(17.4 118 222)">Length</text>
                <text x="296" y="218" transform="rotate(-17.5 296 218)">Width</text>
                <text x="440" y="121">Depth</text>
            </svg>
        </div>
    </section>

    @if (Model.Products.Count > 0)
    {
        <section class="inf-section inf-section--tint" aria-labelledby="calc-popular">
            <div class="container">
                <h2 class="inf-h2 inf-h2--center" id="calc-popular">Popular gravels</h2>
                <div class="inf-products">
                    @foreach (var product in Model.Products)
                    {
                        <a href="@product.Url" class="inf-product">
                            <img class="inf-product__img" src="@product.ImageUrl(600)" alt="" width="600" height="500" loading="lazy" decoding="async">
                            <span class="inf-product__body">
                                <h3 class="inf-product__name">@product.Name</h3>
                                <span class="inf-product__label">Price (inc. VAT &amp; delivery)</span>
                                <span class="inf-product__price">From <span class="cust-price">@HomeProduct.FormatPrice(product.Price, true)</span><span class="trade-price">@HomeProduct.FormatPrice(product.TradePrice, true)</span></span>
                                <span class="inf-product__btn">Shop now</span>
                            </span>
                        </a>
                    }
                </div>
            </div>
        </section>
    }

    <section class="inf-section" aria-labelledby="calc-faqs">
        <div class="container inf-faq">
            <div class="inf-faq__intro">
                <h2 class="inf-h2" id="calc-faqs">Gravel &amp; slate calculator FAQs</h2>
                <p>Can&rsquo;t find your answer? Call us 8am - 5pm on <a href="tel:03300585068">0330 058 5068</a>.</p>
            </div>
            <div class="inf-faq__list">
                @for (var i = 0; i < faqs.Length; i++)
                {
                    var faq = faqs[i];
                    <details class="inf-faq__item" @(i == 0 ? "open" : "")>
                        <summary class="inf-faq__q"><h3>@faq.Question</h3><svg class="inf-faq__chev" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg></summary>
                        <p class="inf-faq__a">@faq.Answer</p>
                    </details>
                }
            </div>
        </div>
    </section>

    @* The old page's four picture links (delivery, offers, reviews, gravels), with their words as text *@
    <section class="inf-section inf-section--tint" aria-labelledby="calc-links">
        <div class="container">
            <h2 class="inf-h2 inf-h2--center" id="calc-links">Before you order</h2>
            <ul class="inf-links">
                <li>
                    <a href="/delivery" class="inf-link">
                        <span class="inf-link__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="6" width="13" height="10" rx="1" /><path d="M14 9h4l3 3v4h-7z" /><circle cx="5.5" cy="17" r="1.6" /><circle cx="17.5" cy="17" r="1.6" /></svg></span>
                        <span class="inf-link__words"><span class="inf-link__title">Delivery information</span><span class="inf-link__text">Tail-lift delivery to the kerbside, on wooden pallets</span></span>
                    </a>
                </li>
                <li>
                    <a href="/special-offers" class="inf-link">
                        <span class="inf-link__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z" /><circle cx="7.5" cy="7.5" r="1.5" /></svg></span>
                        <span class="inf-link__words"><span class="inf-link__title">Special offers</span><span class="inf-link__text">See our current offers</span></span>
                    </a>
                </li>
                <li>
                    <a href="https://uk.trustpilot.com/review/gravelmaster.co.uk" class="inf-link" target="_blank" rel="noopener">
                        <span class="inf-link__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.8l-5.2 2.8 1-5.8-4.3-4.1 5.9-.9z" /></svg></span>
                        <span class="inf-link__words"><span class="inf-link__title">Customer reviews</span><span class="inf-link__text">Read our reviews on Trustpilot<span class="inf-sr"> (opens in a new tab)</span></span></span>
                    </a>
                </li>
                <li>
                    <a href="/garden-chippings/products/" class="inf-link">
                        <span class="inf-link__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="7" cy="15" r="3.2" /><circle cx="15.5" cy="16" r="2.6" /><circle cx="12" cy="9" r="2.8" /><circle cx="18.5" cy="9.5" r="2" /></svg></span>
                        <span class="inf-link__words"><span class="inf-link__title">Gravels &amp; chippings</span><span class="inf-link__text">Shop our gravels and chippings</span></span>
                    </a>
                </li>
            </ul>
        </div>
    </section>
</div>
@Html.Partial("_BulkEnquiryModal", Model.EnquiryCategories)
