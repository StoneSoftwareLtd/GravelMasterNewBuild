@{
    bool isCheckout = Request.Url.ToString().Contains("checkout");

    // New Optima header and footer: on when appSettings UseNewChrome is "true".
    // ?newchrome=1 or ?newchrome=0 overrides it for this browser (via a cookie) during sign-off.
    // Views that show a new page ask NewChrome.IsOn(Request) too, so they always agree with this.
    string chromeOverride = Agilis.ECommerce.Mvc.Web.ViewModels.Common.NewChrome.Override(Request);
    if (chromeOverride != null)
    {
        Response.Cookies.Add(new System.Web.HttpCookie(Agilis.ECommerce.Mvc.Web.ViewModels.Common.NewChrome.CookieName, chromeOverride) { HttpOnly = true });
