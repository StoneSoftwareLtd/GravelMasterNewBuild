    @if (Request.IsLocal)
    {
        @* Local preview only: views and database content hard-code https://www.gravelmaster.co.uk/... links,
           which would jump from localhost to the live site. Keep those clicks on this server. *@
        <script>
            ["click", "auxclick"].forEach(function (type) {
                document.addEventListener(type, function (e) {
                    var link = e.target.closest ? e.target.closest("a[href]") : null;
                    if (!link || !/^(www\.)?gravelmaster\.co\.uk$/i.test(link.hostname)) return;
                    link.href = location.origin + link.pathname + link.search + link.hash;
                }, true);
            });
        </script>
    }
