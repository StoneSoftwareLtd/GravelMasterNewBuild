@* New footer from the Optima prototype (home.html). Styles: css/gm-chrome.css. *@
<footer class="footer">

    <div class="foot-features">
        <img class="foot-features__photo" src="/img/gm-advisor.jpg" alt="GravelMaster customer service advisor">
        <div class="foot-features__grid">
            <div class="foot-feature">
                <span class="foot-feature__icon">
                    <svg viewBox="0 0 24 24" width="45" height="45" fill="none" stroke="#fff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 13v-2a7 7 0 0 1 14 0v2" />
                        <rect x="3.2" y="12.5" width="3.6" height="6" rx="1.3" />
                        <rect x="17.2" y="12.5" width="3.6" height="6" rx="1.3" />
                        <path d="M19 18.5v1a2.5 2.5 0 0 1-2.5 2.5H13" />
                        <circle cx="12" cy="22" r="1.1" />
                    </svg>
                </span>
                <h3 class="foot-feature__title">Need advice?</h3>
                <p class="foot-feature__text"><a href="/contact-us">Our sales team</a> have years of experience and can recommend the perfect hard landscaping products for your next project.</p>
            </div>
            <div class="foot-feature">
                <span class="foot-feature__icon">
                    <svg viewBox="0 0 24 24" width="42" height="42" fill="none" stroke="#fff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <g transform="translate(22.5,1.5) scale(-1,1)">
                            <path d="M11 3H5a2 2 0 0 0-2 2v6l9 9 8-8-9-9z" />
                            <circle cx="7.5" cy="7.5" r="1.3" />
                        </g>
                    </svg>
                </span>
                <h3 class="foot-feature__title">Competitively priced</h3>
                <p class="foot-feature__text">We offer high quality decorative garden stones sourced from around the world, always sold at competitive prices.</p>
            </div>
            <div class="foot-feature">
                <span class="foot-feature__icon">
                    <svg viewBox="0 0 24 24" width="54" height="54" fill="none" stroke="#fff" stroke-width="0.96" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <g transform="translate(1.5 -1.5)">
                            <rect x="3.5" y="8" width="9" height="8" rx="0.6" />
                            <path d="M12.5 11h3.2L18.5 14v2H12.5z" />
                            <circle cx="7" cy="18" r="1.7" />
                            <circle cx="16" cy="18" r="1.7" />
                            <path d="M1 10h2.3M0.5 12.5H3.3M1.5 15H3.3" />
                        </g>
                    </svg>
                </span>
                <h3 class="foot-feature__title">We deliver nationwide</h3>
                <p class="foot-feature__text">Enjoy free nationwide delivery or your desired delivery date. Please note: All orders are delivered on wooden pallets by a lorry with tail lift off load.</p>
            </div>
        </div>
    </div>

    <div class="foot-main">
        <div class="container">
            <div class="foot-brand">
                <img class="foot-brand__logo" src="/img/gm-logo.png" alt="GravelMaster.co.uk">
            </div>

            <div class="foot-cols">
                <div class="foot-col">
                    <h4 class="foot-col__title">Contact us</h4>
                    <p><strong>Freephone:</strong> <a href="tel:03300585068">0330 058 5068</a></p>
                    <p><strong>Sales Team:</strong> Option 1</p>
                    <p><strong>Customer Services:</strong> Option 2</p>
                    <p><strong>Other Enquiries:</strong> Option 3</p>
                    <p class="foot-col__gap"><a href="mailto:customerservices@gravelmaster.co.uk">customerservices@gravelmaster.co.uk</a></p>
                    <p><a href="mailto:sales@gravelmaster.co.uk">sales@gravelmaster.co.uk</a></p>
                    <p class="foot-col__gap">Meteor House Finningley, DN9 3GA</p>
                    <div class="foot-social">
                        <a href="https://www.facebook.com/gravelmaster/" target="_blank" rel="noopener" aria-label="Facebook">
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.3-1.5 1.6-1.5h1.7V3.7c-.3 0-1.4-.1-2.5-.1-2.4 0-4.1 1.5-4.1 4.2v2.2H7.6V13h2.6v8z" /></svg>
                        </a>
                        <a href="https://www.instagram.com/gravelmaster/" target="_blank" rel="noopener" aria-label="Instagram">
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" /></svg>
                        </a>
                        <a href="https://twitter.com/Gravel_Master" target="_blank" rel="noopener" aria-label="X">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M17.5 3h3l-6.6 7.5L21.5 21h-5.9l-4.3-5.6L6.3 21H3.3l7-8L2.8 3h6l3.9 5.1z" /></svg>
                        </a>
                        <a href="https://youtube.com/channel/UCla_uSKoACHrnTDi0WyW8hw" target="_blank" rel="noopener" aria-label="YouTube">
                            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M22 8.2a2.6 2.6 0 0 0-1.8-1.8C18.6 6 12 6 12 6s-6.6 0-8.2.4A2.6 2.6 0 0 0 2 8.2 27 27 0 0 0 1.7 12 27 27 0 0 0 2 15.8a2.6 2.6 0 0 0 1.8 1.8C5.4 18 12 18 12 18s6.6 0 8.2-.4a2.6 2.6 0 0 0 1.8-1.8A27 27 0 0 0 22.3 12 27 27 0 0 0 22 8.2zM10 15V9l5.2 3z" /></svg>
                        </a>
                    </div>
                </div>

                <div class="foot-col">
                    <h4 class="foot-col__title">Opening hours</h4>
                    <p>Monday - Wednesday - 8am-5pm</p>
                    <p>Thursday - Friday 8am-5pm</p>
                    <p>Weekends - Closed</p>
                    <p>Bank holidays - Closed</p>
                </div>

                <div class="foot-col">
                    <h4 class="foot-col__title">Help and support</h4>
                    <ul class="foot-links">
                        <li><a href="/calculator">Quantity Calculator</a></li>
                        <li><a href="/delivery">Delivery</a></li>
                        <li><a href="/faq">FAQs</a></li>
                        <li><a href="/articles">Articles</a></li>
                        <li><a href="/blog">Blog</a></li>
                    </ul>
                </div>

                <div class="foot-col foot-col--news">
                    <h4 class="foot-col__title">Sign up to our newsletter</h4>
                    <p>Find out about our latest products &amp; offers</p>
                    @* newsletterregister() in _Layout reads #sign-up-email and reveals #sign-up-thank-you-msg. *@
                    <form class="foot-news" onsubmit="newsletterregister(); return false;">
                        <input type="email" id="sign-up-email" class="foot-news__input" placeholder="Enter your email" aria-label="Email address">
                        <button type="submit" class="foot-news__btn" aria-label="Subscribe">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M21 3L3 10.5l7 2.5 2.5 7z" />
                                <path d="M21 3l-11 10" />
                            </svg>
                        </button>
                    </form>
                    <p id="sign-up-thank-you-msg" class="foot-news__thanks" style="display:none">Thank you for signing up for emails</p>
                </div>
            </div>
        </div>
    </div>

    <div class="foot-bottom">
        <div class="container foot-bottom__inner">
            <div class="foot-bottom__left">
                <span>&copy; Gravelmaster @(DateTime.Now.Year). All rights reserved.</span>
                <a href="/term-conditions">Terms &amp; Conditions</a>
                <a href="/privacy">Privacy Policy</a>
            </div>
            <div class="foot-bottom__right">
                <span class="foot-secure">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="5" y="11" width="14" height="9" rx="2" />
                        <path d="M8 11V8a4 4 0 0 1 8 0v3" />
                    </svg>
                    Secure shopping
                </span>
                <div class="foot-pay" aria-label="Accepted payment methods">
                    <img src="/img/gm-payment-cards.png" alt="Accepted payment methods: PayPal, Visa, Mastercard, American Express">
                </div>
            </div>
        </div>
    </div>

</footer>
