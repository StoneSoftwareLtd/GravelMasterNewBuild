@model Agilis.ECommerce.Mvc.Web.ViewModels.Common.CategoryPageModel
@using Agilis.ECommerce.Mvc.Web.ViewModels.Common
@{
    var description = Model.Description;

    // "Ideal for" icons: the first entry whose word is in a use gives that use its icon. Other uses get a tick.
    var idealIcons = new[]
    {
        new { Word = "pond", Icon = "/img/gm-cat-ideal-pond.png" },
        new { Word = "water", Icon = "/img/gm-cat-ideal-pond.png" },
        new { Word = "aquatic", Icon = "/img/gm-cat-ideal-aquatics.png" },
        new { Word = "mulch", Icon = "/img/gm-cat-ideal-mulch.png" },
        new { Word = "landscap", Icon = "/img/gm-cat-ideal-landscaping.png" },
        new { Word = "garden", Icon = "/img/gm-cat-ideal-landscaping.png" }
    };

    // The product each category highlights in the promo card (by category and product URL name). It shows on the
    // unfiltered page in the default order, in place of that product's normal card, after the first promoPosition
    // cards. (Filtered or sorted, the products stay exactly as asked for.)
    var promoProducts = new Dictionary<string, string>
    {
        { "garden-chippings", "flamenco-gravel-20mm" },
        { "slate-chippings", "blue-slate-20mm" },
        { "topsoil-and-compost", "screened-topsoil" },
        { "cobbles-and-pebbles-rockery", "scottish-cobbles-30-50mm" },
        { "scottish", "scottish-cobbles-30-50mm" }
    };
    const int promoPosition = 5;

    CategoryProduct promo = null;
    string promoUrl;
    if (!Model.IsFiltered && Model.SelectedSort == CategoryPageModel.SortOptions[0] && Model.CategoryUrl != null && promoProducts.TryGetValue(Model.CategoryUrl, out promoUrl))
    {
        promo = Model.Products.FirstOrDefault(p => p.Url.EndsWith("/p/" + promoUrl, StringComparison.OrdinalIgnoreCase));
    }
    var gridProducts = Model.Products.Where(p => p != promo).ToList();
    if (promo != null)
    {
        gridProducts.Insert(Math.Min(promoPosition, gridProducts.Count), promo);
    }
    int count = Model.Products.Count;
    string productsText = count + (count == 1 ? " product" : " products");
}
@* New category page from the Optima prototype (gravel-master-category.html). Styles: css/gm-category.css.
   Behaviour: js/gm-category.js. "Read more" and the filter groups are <details>, so they work without JavaScript.
   The bulk enquiry pop-up ("Enquire Here") is the shared _BulkEnquiryModal. *@
<div class="gm-category">

    <div class="plp-top">
        <nav class="container plp-crumbs" aria-label="Breadcrumb">
            <ol class="plp-crumbs__list">
                <li><a href="/">Home</a></li>
                @foreach (var crumb in Model.Breadcrumbs)
                {
                    if (crumb.Url != null)
                    {
                        <li><a href="@crumb.Url">@crumb.Name</a></li>
                    }
                    else
                    {
                        <li><span class="plp-crumbs__current" aria-current="page">@crumb.Name</span></li>
                    }
                }
            </ol>
        </nav>

        <section class="plp-intro">
            <div class="container plp-intro__inner">
                <div class="plp-intro__copy">
                    <h1 class="plp-intro__title">@Model.Title</h1>
                    @if (description.IntroHtml.Length > 0)
                    {
                        <div class="plp-intro__text">@Html.Raw(description.IntroHtml)</div>
                    }
                    @if (description.MoreHtml != null)
                    {
                        <details class="plp-more">
                            <summary class="plp-more__toggle"><span class="plp-more__closed">Read more</span><span class="plp-more__open">Read less</span></summary>
                            <div class="plp-more__body">@Html.Raw(description.MoreHtml)</div>
                        </details>
                    }
                </div>
                @if (description.IdealFor.Count > 0)
                {
                    <div class="plp-ideal">
                        <h2 class="plp-ideal__label">Ideal for</h2>
                        <ul class="plp-ideal__grid">
                            @foreach (var use in description.IdealFor)
                            {
                                var icon = idealIcons.FirstOrDefault(i => use.IndexOf(i.Word, StringComparison.OrdinalIgnoreCase) >= 0);
                                <li class="plp-ideal__item">
                                    <span class="plp-ideal__icon">
                                        @if (icon != null)
                                        {
                                            <img src="@icon.Icon" alt="" width="44" height="44">
                                        }
                                        else
                                        {
                                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="5 12.5 10 17.5 19 7.5" /></svg>
                                        }
                                    </span>
                                    <span>@use</span>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </section>
    </div>

    @if (Model.FilterGroups.Count > 0)
    {
        @* Phones: sticks under the header and opens the filters as a drawer *@
        <div class="plp-filterbar container">
            <button class="plp-filterbtn" type="button" aria-controls="plp-filters" aria-expanded="false">
                Filters@(Model.IsFiltered ? " (" + Model.FilterGroups.Sum(g => g.Options.Count(o => o.Selected)) + ")" : "")
                <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="7" x2="21" y2="7" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="17" x2="21" y2="17" /><circle cx="9" cy="7" r="2" fill="#fff" /><circle cx="15" cy="12" r="2" fill="#fff" /><circle cx="8" cy="17" r="2" fill="#fff" /></svg>
            </button>
        </div>
    }

    <div class="container plp-layout">

        <aside class="plp-side" aria-label="Delivery, filters and trade">
            @if (!string.IsNullOrWhiteSpace(Model.DeliveryMessage))
            {
                <div class="plp-count">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="6" width="13" height="10" rx="1" /><path d="M14 9h4l3 3v4h-7z" /><circle cx="5.5" cy="17" r="1.6" /><circle cx="17.5" cy="17" r="1.6" /></svg>
                    <p>@Model.DeliveryMessage</p>
                </div>
            }

            @if (Model.FilterGroups.Count > 0)
            {
                <div class="plp-filterwrap" id="plp-filters" aria-labelledby="plp-filters-title">
                    @* Phones only: closes the drawer *@
                    <button class="plp-filterwrap__close" type="button" aria-label="Close filters">&times;</button>

                    <div class="plp-filters-head">
                        <h2 id="plp-filters-title">Filters</h2>
                        @if (Model.IsFiltered)
                        {
                            <a href="@Model.ClearFiltersUrl" class="plp-clear">Clear all filters</a>
                        }
                    </div>

                    @for (int g = 0; g < Model.FilterGroups.Count; g++)
                    {
                        var group = Model.FilterGroups[g];
                        @* The first two groups, and any with a filter chosen, start open *@
                        <details class="plp-group" @(g < 2 || group.HasSelection ? "open" : "")>
                            <summary class="plp-group__bar">
                                <span>@group.Name</span>
                                <svg class="plp-group__chev" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 15 12 9 18 15" /></svg>
                            </summary>
                            <ul class="plp-checks">
                                @foreach (var option in group.Options)
                                {
                                    <li>
                                        <a href="@option.Url" class="plp-check@(option.Selected ? " is-on" : "")">
                                            <span class="plp-box" aria-hidden="true">
                                                @if (option.Selected)
                                                {
                                                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="#fff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4.5 12.5 9.5 17.5 19.5 6.5" /></svg>
                                                }
                                            </span>
                                            @option.Name
                                            @if (option.Selected)
                                            {
                                                <span class="gm-sr">(chosen, select to remove)</span>
                                            }
                                        </a>
                                    </li>
                                }
                            </ul>
                        </details>
                    }

                    <button class="plp-filterwrap__apply" type="button">Show @productsText</button>
                </div>
            }

            @* PayPal's Pay in 3 message; the PayPal script is loaded by _Layout. The logo sits above the text: with it
               inline PayPal needs 350px and hides the message in the 280px sidebar. *@
            <div class="plp-pay" data-pp-message data-pp-style-layout="text" data-pp-style-logo-type="primary" data-pp-style-text-color="black"></div>

            <div class="plp-trade">
                <h2 class="plp-trade__title">Trade? We&rsquo;ve got you covered</h2>
                <ul class="plp-trade__icons">
                    <li>
                        <span class="plp-trade__ic">
                            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="#fff" stroke-width="1.26" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><g transform="translate(24,0) scale(-1,1)"><path d="M11.5 3H5a2 2 0 0 0-2 2v6.5a2 2 0 0 0 .6 1.4l7.5 7.5a2 2 0 0 0 2.8 0l6.1-6.1a2 2 0 0 0 0-2.8L12.9 3.6A2 2 0 0 0 11.5 3z" /><circle cx="7.5" cy="7.5" r="1.2" /></g><path d="M16.9 6.3c1.3-1.1 2.9-.8 3.3.5" /><circle cx="10" cy="10.6" r="1.15" /><circle cx="14.2" cy="14.2" r="1.15" /><line x1="15" y1="9.7" x2="9.2" y2="15.1" /></svg>
                        </span>
                        <span class="plp-trade__lbl">Exclusive<br>Pricing</span>
                    </li>
                    <li>
                        <span class="plp-trade__ic">
                            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="#fff" stroke-width="1.26" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 5.5h15A1.5 1.5 0 0 1 21 7v7.5A1.5 1.5 0 0 1 19.5 16h-5.2L12 18.8 9.7 16H4.5A1.5 1.5 0 0 1 3 14.5V7a1.5 1.5 0 0 1 1.5-1.5z" /><path d="M12 6.85 13 9.38 15.71 9.55 13.62 11.28 14.29 13.91 12 12.45 9.71 13.91 10.38 11.28 8.29 9.55 11 9.38Z" /></svg>
                        </span>
                        <span class="plp-trade__lbl">Priority<br>Support</span>
                    </li>
                    <li>
                        <span class="plp-trade__ic">
                            <svg viewBox="0 0 24 24" width="47" height="47" fill="none" stroke="#fff" stroke-width="1.07" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><g transform="translate(0 -1.5)"><rect x="4.5" y="9.4" width="15" height="10.6" rx="0.8" /><line x1="4.5" y1="13.4" x2="19.5" y2="13.4" /><line x1="12" y1="9.4" x2="12" y2="20" /><path d="M12 9.4C12 7.3 10.7 5.8 9.2 5.8 8 5.8 7.6 7.1 8.5 7.9 9.4 8.7 12 9.4 12 9.4z" /><path d="M12 9.4C12 7.3 13.3 5.8 14.8 5.8 16 5.8 16.4 7.1 15.5 7.9 14.6 8.7 12 9.4 12 9.4z" /></g></svg>
                        </span>
                        <span class="plp-trade__lbl">Free<br>Samples</span>
                    </li>
                </ul>
                <a href="/account/login?isTradeRegister=true" class="plp-trade__btn">Get trade prices</a>
            </div>
        </aside>

        <section class="plp-products" aria-labelledby="plp-products-title">
            <h2 class="gm-sr" id="plp-products-title">Products</h2>
            <div class="plp-toolbar">
                <p class="plp-toolbar__count">Showing @productsText</p>
                @* Posts "sort" back to this address, as the old page's Sort by did *@
                <form class="plp-sort" method="post">
                    <label class="plp-sort__label" for="plp-sort">Sort by:</label>
                    <select class="plp-sort__select" id="plp-sort" name="sort" data-sort-select>
                        @foreach (var sort in CategoryPageModel.SortOptions)
                        {
                            <option @(sort == Model.SelectedSort ? "selected" : "")>@sort</option>
                        }
                    </select>
                    <noscript><button type="submit" class="plp-sort__go">Sort</button></noscript>
                </form>
            </div>

            @if (count == 0)
            {
                <div class="plp-empty">
                    <p>No products match these filters.</p>
                    @if (Model.IsFiltered)
                    {
                        <p><a href="@Model.ClearFiltersUrl">Clear all filters</a></p>
                    }
                </div>
            }
            else
            {
                <div class="plp-grid">
                    @for (int i = 0; i < gridProducts.Count; i++)
                    {
                        var product = gridProducts[i];
                        if (product == promo)
                        {
                            <a href="@product.Url" class="plp-promotile">
                                <div class="plp-promotile__media">
                                    <img class="plp-promotile__img" src="@product.ImageUrl(600)" alt="" width="600" height="600" loading="lazy">
                                    <span class="plp-promotile__badge"><span class="plp-promotile__badge-sm">FROM</span><span class="plp-promotile__badge-big"><span class="cust-price">@HomeProduct.FormatPrice(product.Price, false)</span><span class="trade-price">@HomeProduct.FormatPrice(product.TradePrice, false)</span></span><span class="plp-promotile__badge-sm">BULK BAG</span></span>
                                </div>
                                <div class="plp-promotile__body">
                                    <h3 class="plp-promotile__title">@product.Name</h3>
                                    <p class="plp-promotile__text">@product.Synopsis</p>
                                    <span class="plp-promotile__btn">Shop @product.Name</span>
                                </div>
                            </a>
                        }
                        else
                        {
                            <a href="@product.Url" class="plp-card">
                                <div class="plp-card__media">
                                    <img class="plp-card__img" src="@product.ImageUrl(330)" srcset="@product.ImageUrl(330) 330w, @product.ImageUrl(600) 600w" sizes="(max-width: 560px) calc(100vw - 36px), (max-width: 860px) calc(50vw - 30px), (max-width: 1100px) calc(50vw - 190px), 350px" alt="" width="330" height="330" loading="@(i < 3 ? "eager" : "lazy")">
                                    @* Shown to trade customers only, by _Layout's /product/istrade check *@
                                    <span class="plp-card__trade trade-price">Trade price</span>
                                </div>
                                <h3 class="plp-card__name">@product.Name</h3>
                                <p class="plp-card__desc">@product.Synopsis</p>
                                <p class="plp-card__pricelabel">Price (inc. VAT &amp; delivery)</p>
                                <p class="plp-card__price">From <span class="cust-price">@HomeProduct.FormatPrice(product.Price, true)</span><span class="trade-price">@HomeProduct.FormatPrice(product.TradePrice, true)</span></p>
                                <span class="plp-card__btn">Shop now</span>
                            </a>
                        }
                    }
                </div>
            }
        </section>
    </div>

    <div class="container">
        <div class="plp-bulk">
            <p class="plp-bulk__title">Ordering 10 tonnes or more?</p>
            <p class="plp-bulk__text">Call <a href="tel:03300585068">0330 058 5068</a> or enquire online to book a loose load delivery on bulk orders over 10 tonnes</p>
            <button type="button" class="plp-bulk__btn" data-bulk-open>Enquire Here</button>
        </div>
    </div>

    <div class="plp-filter-backdrop" hidden></div>
</div>
@Html.Partial("_BulkEnquiryModal", Model.EnquiryCategories)
<script src="/js/gm-category.js?v1"></script>
