@model Agilis.ECommerce.Mvc.Web.ViewModels.Common.SearchPageModel
@using Agilis.ECommerce.Mvc.Web.ViewModels.Common
@{
    string phrase = Model.ShownPhrase;
    int count = Model.Products.Count;
    string productsText = count + (count == 1 ? " product" : " products");
}
@* New search results page. There's no Optima prototype for it, so it is the category page's intro band and product
   cards (Views/Shared/_CategoryPage.cshtml), full width without the sidebar. It sits inside .gm-category and loads
   css/gm-category.css, then css/gm-search.css for its own parts, so the cards look exactly like the category page's.
   Behaviour: js/gm-search.js. *@
<div class="gm-category gm-search" data-search-phrase="@phrase">

    <div class="plp-top">
        <nav class="container plp-crumbs" aria-label="Breadcrumb">
            <ol class="plp-crumbs__list">
                <li><a href="/">Home</a></li>
                <li><span class="plp-crumbs__current" aria-current="page">Search results</span></li>
            </ol>
        </nav>

        <section class="plp-intro srch-intro">
            <div class="container">
                @if (phrase.Length > 0)
                {
                    <h1 class="plp-intro__title srch-title">Search results for <span class="srch-title__phrase">&ldquo;@phrase&rdquo;</span></h1>
                }
                else
                {
                    <h1 class="plp-intro__title srch-title">All products</h1>
                }
                <p class="srch-count">@(count == 0 ? "No products found" : Model.HasMore ? "Showing the first " + productsText : productsText + " found")</p>
            </div>
        </section>
    </div>

    <div class="container srch-body">
        @if (count > 0)
        {
            <h2 class="gm-sr">Products</h2>
            <div class="plp-grid srch-grid">
                @for (int i = 0; i < Model.Products.Count; i++)
                {
                    var product = Model.Products[i];
                    @* The category page's card; "sizes" is for this page's four columns *@
                    <a href="@product.Url" class="plp-card">
                        <div class="plp-card__media">
                            <img class="plp-card__img" src="@product.ImageUrl(330)" srcset="@product.ImageUrl(330) 330w, @product.ImageUrl(600) 600w" sizes="(max-width: 560px) calc(100vw - 36px), (max-width: 860px) calc(50vw - 30px), (max-width: 1100px) calc(33.3vw - 28px), (max-width: 1480px) calc(25vw - 27px), 343px" alt="" width="330" height="330" loading="@(i < 4 ? "eager" : "lazy")">
                            @* Shown to trade customers only, by _Layout's /product/istrade check *@
                            <span class="plp-card__trade trade-price">Trade price</span>
                        </div>
                        <h3 class="plp-card__name">@product.Name</h3>
                        <p class="plp-card__desc">@product.Synopsis</p>
                        <p class="plp-card__pricelabel">Price (inc. VAT &amp; delivery)</p>
                        <p class="plp-card__price">From <span class="cust-price">@HomeProduct.FormatPrice(product.Price, true)</span><span class="trade-price">@HomeProduct.FormatPrice(product.TradePrice, true)</span></p>
                        <span class="plp-card__btn">Shop now</span>
                    </a>
                }
            </div>
        }

        @* Nothing found, or more found than the page shows: other ways to find a product *@
        @if (count == 0 || Model.HasMore)
        {
            <section class="srch-help" aria-labelledby="srch-help-title">
                @if (count == 0)
                {
                    if (phrase.Length > 0)
                    {
                        <h2 class="srch-help__title" id="srch-help-title">We couldn&rsquo;t find any products matching &ldquo;@phrase&rdquo;</h2>
                    }
                    else
                    {
                        <h2 class="srch-help__title" id="srch-help-title">We couldn&rsquo;t find any products</h2>
                    }
                    @* The search looks for what was typed in product names only (CategoryController.DisplayBrand) *@
                    <p class="srch-help__text">Our search looks for what you typed in our product names. Check the spelling, or try a single word, such as <a href="/search?searchphrase=gravel">gravel</a>, <a href="/search?searchphrase=slate">slate</a> or <a href="/search?searchphrase=bark">bark</a>. Or shop by category:</p>
                }
                else
                {
                    <h2 class="srch-help__title" id="srch-help-title">Looking for something else?</h2>
                    <p class="srch-help__text">Not every product fits on this page. @(phrase.Length > 0 ? "Add another word to narrow your search" : "Search for a product by name"), or shop by category:</p>
                }
                <ul class="srch-cats">
                    @foreach (var category in Model.Categories)
                    {
                        <li><a href="@category.Url" class="srch-cats__link">@category.Name</a></li>
                    }
                </ul>
                <p class="srch-help__call">Can&rsquo;t find what you need? Call us 8am - 5pm on <a href="tel:03300585068">0330 058 5068</a></p>
            </section>
        }
    </div>
</div>
<script src="/js/gm-search.js?v1" defer></script>
